// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitType {
  EQUAL
  PERCENTAGE
  EXACT
  ITEMIZED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  createdGroups      Group[]            @relation("GroupCreator")
  memberships        GroupMember[]
  paidExpenses       Expense[]          @relation("ExpensePayer")
  expenseSplits      ExpenseSplit[]
  expenseItemShares  ExpenseItemShare[]
  settlementsFrom    Settlement[]       @relation("SettlementFrom")
  settlementsTo      Settlement[]       @relation("SettlementTo")
  recordedSettlements Settlement[]      @relation("SettlementRecordedBy")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())

  creator     User          @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Expense {
  id          String    @id @default(cuid())
  groupId     String
  paidBy      String
  description String
  totalAmount Decimal   @db.Decimal(12, 2)
  category    String
  splitType   SplitType
  metadata    Json?
  createdAt   DateTime  @default(now())

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer  User           @relation("ExpensePayer", fields: [paidBy], references: [id], onDelete: Restrict)
  splits ExpenseSplit[]
  items  ExpenseItem[]
}

model ExpenseSplit {
  id         String   @id @default(cuid())
  expenseId  String
  userId     String
  amountOwed Decimal  @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(5, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseItem {
  id         String  @id @default(cuid())
  expenseId  String
  itemName   String
  itemAmount Decimal @db.Decimal(12, 2)

  expense Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  shares  ExpenseItemShare[]
}

model ExpenseItemShare {
  id          String  @id @default(cuid())
  itemId      String
  userId      String
  shareAmount Decimal @db.Decimal(12, 2)

  item ExpenseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settlement {
  id         String   @id @default(cuid())
  groupId    String
  fromUser   String
  toUser     String
  recordedBy String
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from     User  @relation("SettlementFrom", fields: [fromUser], references: [id], onDelete: Restrict)
  to       User  @relation("SettlementTo", fields: [toUser], references: [id], onDelete: Restrict)
  recorder User  @relation("SettlementRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)
}
